# Scenario A — VINE copula (omega_dist = vine).
#
# Same 1-cpt IV model and data (data/vine_tail_iv.csv) as
# examples/vine_tail_iv_gaussian.ferx. The data carry ASYMMETRIC lower-tail
# dependence between ETA_CL and ETA_V (Clayton copula: Kendall tau~0.40,
# lambda_L~0.59, lambda_U=0): low-clearance subjects also have low volume far
# more often than the upper tail is concordant.
#
# omega_dist = vine keeps each ETA marginally Gaussian (diagonal Omega) but
# estimates the *dependence* with a D-vine pair-copula whose family is selected
# from the data. It can recover the Clayton lower-tail dependence that a symmetric
# Gaussian copula (block Omega baseline) cannot, improving the vine-corrected
# OFV / AIC / BIC. Inspect the reported pair-copula family and lower-tail
# dependence (lambda_L) in the "Vine Copula" output block.
#
# NOTE: vine requires a DIAGONAL Omega — the copula carries all inter-ETA dependence.

[parameters]
  theta TVCL(4.0, 0.1, 100.0)
  theta TVV(50.0, 1.0, 500.0)

  omega ETA_CL ~ 0.09
  omega ETA_V  ~ 0.09

  sigma PROP_ERR ~ 0.10 (sd)

[individual_parameters]
  CL = TVCL * exp(ETA_CL)
  V  = TVV  * exp(ETA_V)

[structural_model]
  pk one_cpt_iv(cl=CL, v=V)

[error_model]
  DV ~ proportional(PROP_ERR)

[fit_options]
  method        = saem
  omega_dist    = vine
  n_exploration = 300
  n_convergence = 400
  seed          = 12345
  covariance    = true
